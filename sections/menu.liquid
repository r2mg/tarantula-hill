    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "main", "label": "White" },
        { "value": "alt", "label": "Light Gray" },
        { "value": "invert", "label": "Black" }
      ],
      "default": "main"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "The Kitchen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Menu"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "info": "Leave blank to hide"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Menu Category",
      "settings": [
        {
          "type": "text",
