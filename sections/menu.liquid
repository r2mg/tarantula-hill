{% comment %}
  Section: Menu
  Displays the full T-Hill menu organized by category.
  Each category is a block — add, remove, or reorder in the theme editor.
  Mobile: scrollable horizontal tab bar, single-column items.
  Desktop: sticky sidebar nav on the left, two-column items on the right.
  Add via: Online Store > Themes > Customize > Add Section
{% endcomment %}

{%- assign section_id = 'menu-' | append: section.id -%}

<div class="section-wrapper color-scheme-{{ section.settings.color_scheme }} section-wrapper--y-offset--padding" id="{{ section_id }}">

  {% if section.settings.heading != blank %}
    <div class="container section-wrapper__header" style="margin-bottom: 2.5rem;">
      <div class="content content--align--{{ section.settings.heading_align }}">
        {% if section.settings.eyebrow != blank %}
          <div class="content__subheading">
            <div class="subheading">{{ section.settings.eyebrow }}</div>
          </div>
        {% endif %}
        <div class="content__heading">
          <h2 class="heading heading--size--h1">{{ section.settings.heading }}</h2>
        </div>
        {% if section.settings.description != blank %}
          <div class="content__text"><div class="rte">{{ section.settings.description }}</div></div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <div class="menu-tabs-bar" role="tablist" aria-label="Menu categories">
    <div class="menu-tabs-inner">
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          <button
            class="menu-tab{% if forloop.first %} menu-tab--active{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="cat-{{ section.id }}-{{ forloop.index }}"
            data-target="cat-{{ section.id }}-{{ forloop.index }}"
            type="button"
          >{{ block.settings.category_name }}</button>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="container menu-body">

    <nav class="menu-sidebar" aria-label="Jump to menu section">
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          <a
            href="#cat-{{ section.id }}-{{ forloop.index }}"
            class="menu-sidebar__link{% if forloop.first %} menu-sidebar__link--active{% endif %}"
            data-target="cat-{{ section.id }}-{{ forloop.index }}"
          >{{ block.settings.category_name }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <div class="menu-content" role="tabpanel">
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          <div
            class="menu-panel{% if forloop.first %} menu-panel--active{% endif %}"
            id="cat-{{ section.id }}-{{ forloop.index }}"
            {{ block.shopify_attributes }}
          >
            <div class="menu-panel__header">
              <h3 class="menu-panel__title heading">{{ block.settings.category_name }}</h3>
              {% if block.settings.category_note != blank %}
                <p class="menu-panel__note">{{ block.settings.category_note }}</p>
              {% endif %}
            </div>

            <div class="menu-items">
              {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
              {%- assign iname = '' -%}
              {%- assign iprice = '' -%}
              {%- assign idesc = '' -%}

              {%- for raw_line in lines -%}
                {%- assign ln = raw_line | strip | strip_html -%}
                {%- if ln == '' -%}
                  {%- if iname != '' -%}
                    <div class="menu-item">
                      <div class="menu-item__top">
                        <span class="menu-item__name">{{ iname }}</span>
                        <span class="menu-item__dots" aria-hidden="true"></span>
                        <span class="menu-item__price">{{ iprice }}</span>
                      </div>
                      {%- if idesc != '' -%}<p class="menu-item__desc">{{ idesc }}</p>{%- endif -%}
                    </div>
                    {%- assign iname = '' -%}{%- assign iprice = '' -%}{%- assign idesc = '' -%}
                  {%- endif -%}
                {%- elsif ln contains '$' and iname == '' -%}
                  {%- assign parts = ln | split: '$' -%}
                  {%- assign iname = parts[0] | strip -%}
                  {%- assign iprice = '$' | append: parts[1] | strip -%}
                {%- elsif iname == '' -%}
                  {%- assign iname = ln -%}
                {%- elsif iprice == '' and ln contains '$' -%}
                  {%- assign iprice = ln -%}
                {%- else -%}
                  {%- if idesc == '' -%}
                    {%- assign idesc = ln -%}
                  {%- else -%}
                    {%- assign idesc = idesc | append: ' ' | append: ln -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if iname != '' -%}
                <div class="menu-item">
                  <div class="menu-item__top">
                    <span class="menu-item__name">{{ iname }}</span>
                    <span class="menu-item__dots" aria-hidden="true"></span>
                    <span class="menu-item__price">{{ iprice }}</span>
                  </div>
                  {%- if idesc != '' -%}<p class="menu-item__desc">{{ idesc }}</p>{%- endif -%}
                </div>
              {%- endif -%}
            </div>

            {% if block.settings.category_footer != blank %}
              <p class="menu-panel__footer">{{ block.settings.category_footer }}</p>
            {% endif %}

          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</div>

<style>
  .menu-tabs-bar {
    border-bottom: 1px solid var(--color-scheme-border);
    overflow: hidden;
  }
  .menu-tabs-inner {
    display: flex;
    justify-content: center;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0 2rem;
  }
  .menu-tabs-inner::-webkit-scrollbar { display: none; }
  .menu-tab {
    flex-shrink: 0;
    font-family: var(--glob-subheading-font);
    font-weight: var(--glob-subheading-weight);
    text-transform: var(--glob-subheading-text-transform);
    font-size: calc(var(--glob-text-scale-xs) * 1rem);
    letter-spacing: 0.12em;
    color: var(--color-scheme-text);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 1rem 1.25rem;
    cursor: pointer;
    opacity: 0.45;
    transition: opacity 0.15s, border-color 0.15s;
    white-space: nowrap;
    margin-bottom: -1px;
  }
  .menu-tab:hover { opacity: 0.75; }
  .menu-tab--active { opacity: 1; border-bottom-color: var(--color-scheme-text); }

  .menu-body {
    display: block;
    padding-top: 3rem;
  }

  .menu-sidebar {
    display: none;
  }
  .menu-sidebar__link {
    font-family: var(--glob-subheading-font);
    font-weight: var(--glob-subheading-weight);
    text-transform: var(--glob-subheading-text-transform);
    font-size: calc(var(--glob-text-scale-xs) * 1rem);
    letter-spacing: 0.1em;
    color: var(--color-scheme-text);
    text-decoration: none;
    padding: 0.6rem 0 0.6rem 1rem;
    border-left: 2px solid transparent;
    opacity: 0.4;
    transition: opacity 0.15s, border-color 0.15s;
    display: block;
    line-height: 1.3;
  }
  .menu-sidebar__link:hover { opacity: 0.7; text-decoration: none; }
  .menu-sidebar__link--active { opacity: 1; border-left-color: var(--color-scheme-text); }

  .menu-panel { display: none; }
  .menu-panel--active { display: block; }

  .menu-panel__header {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-scheme-border);
    margin-bottom: 1.5rem;
  }
  .menu-panel__title {
    font-family: var(--glob-heading-font) !important;
    font-weight: var(--glob-heading-font-weight) !important;
    text-transform: var(--glob-heading-transform) !important;
    font-size: clamp(1.5rem, 3vw, 2.25rem) !important;
    margin: 0 0 0.3rem !important;
  }
  .menu-panel__note {
    font-size: calc(var(--glob-text-scale-xs) * 1rem);
    opacity: 0.5;
    font-style: italic;
    margin: 0;
    line-height: 1.5;
  }
  .menu-panel__footer {
    font-size: calc(var(--glob-text-scale-xs) * 1rem);
    opacity: 0.5;
    font-style: italic;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-scheme-border);
    line-height: 1.6;
  }

  .menu-items {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 3rem;
  }
  .menu-item {
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-scheme-border);
  }
  .menu-item__top {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin-bottom: 0.25rem;
  }
  .menu-item__name {
    font-family: var(--glob-subheading-font);
    font-weight: var(--glob-subheading-weight);
    font-size: calc(var(--glob-text-scale-sm) * 1rem);
    text-transform: var(--glob-subheading-text-transform);
    letter-spacing: 0.04em;
    flex-shrink: 0;
    max-width: 62%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .menu-item__dots {
    flex: 1;
    border-bottom: 1px dotted var(--color-scheme-border);
    margin-bottom: 3px;
    min-width: 8px;
  }
  .menu-item__price {
    font-family: var(--glob-subheading-font);
    font-weight: var(--glob-subheading-weight);
    font-size: calc(var(--glob-text-scale-sm) * 1rem);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .menu-item__desc {
    font-size: calc(var(--glob-text-scale-xs) * 1rem);
    line-height: 1.55;
    opacity: 0.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .menu-body {
      padding-top: 1.5rem;
    }
    .menu-items { grid-template-columns: 1fr; }
    .menu-item__name { max-width: 58%; }
    .menu-tabs-inner { padding: 0 1rem; }
  }
</style>

<script>
(function() {
  var root = document.getElementById('{{ section_id }}');
  if (!root) return;
  var tabs = root.querySelectorAll('.menu-tab');
  var panels = root.querySelectorAll('.menu-panel');
  var links = root.querySelectorAll('.menu-sidebar__link');

  function activate(id) {
    tabs.forEach(function(t) {
      var on = t.dataset.target === id;
      t.classList.toggle('menu-tab--active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      if (on) t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    });
    panels.forEach(function(p) { p.classList.toggle('menu-panel--active', p.id === id); });
    links.forEach(function(l) { l.classList.toggle('menu-sidebar__link--active', l.dataset.target === id); });
  }

  tabs.forEach(function(t) { t.addEventListener('click', function() { activate(this.dataset.target); }); });
  links.forEach(function(l) { l.addEventListener('click', function(e) { e.preventDefault(); activate(this.dataset.target); }); });
})();
</script>

{% schema %}
