{% comment %}
  Section: Reserve Your Spot — Picnic Table Seating
  Location: Tarantula Hill Brewing Co. — Book a Party page
  Add via: Online Store > Themes > Customize > Add Section
{% endcomment %}

<div class="section-wrapper color-scheme-{{ section.settings.color_scheme }} section-wrapper--y-offset--padding">
  <div class="section__inner container">

    {% if section.settings.eyebrow != blank %}
      <p class="subheading" style="margin-bottom: 0.5rem; font-size: calc(var(--glob-text-scale-xs) * 1rem);">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="section__heading" style="
        font-family: var(--glob-heading-font);
        font-weight: var(--glob-heading-font-weight);
        text-transform: var(--glob-heading-transform);
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        line-height: 1.05;
        margin-bottom: 0.75rem;
      ">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="rte" style="
        max-width: 640px;
        margin-bottom: 2.5rem;
        opacity: 0.7;
        font-size: calc(var(--glob-text-scale-sm) * 1rem);
        line-height: 1.65;
      ">
        {{ section.settings.description }}
      </div>
    {% endif %}

    {%- comment -%} Seating tier cards {%- endcomment -%}
    <div style="
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    ">
      {% for block in section.blocks %}
        {% if block.type == 'seating_tier' %}
          <div {{ block.shopify_attributes }} style="
            border: 1px solid var(--color-scheme-border);
            padding: 1.75rem 1.5rem;
            border-radius: 0;
            text-align: center;
          ">
            <p style="
              font-family: var(--glob-heading-font);
              font-weight: var(--glob-heading-font-weight);
              text-transform: var(--glob-heading-transform);
              font-size: 1.1rem;
              margin-bottom: 0.25rem;
            ">{{ block.settings.guest_label }}</p>

            <p style="
              font-size: calc(var(--glob-text-scale-xs) * 1rem);
              opacity: 0.55;
              font-family: var(--glob-subheading-font);
              font-weight: var(--glob-subheading-weight);
              text-transform: var(--glob-subheading-text-transform);
              letter-spacing: 0.1em;
              margin-bottom: 1rem;
            ">{{ block.settings.table_count }}</p>

            <p style="
              font-family: var(--glob-heading-font);
              font-weight: var(--glob-heading-font-weight);
              font-size: clamp(1.75rem, 4vw, 2.25rem);
              line-height: 1;
            ">{{ block.settings.price }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {%- comment -%} Policy / abandonment block {%- endcomment -%}
    {% if section.settings.policy_text != blank %}
      <div style="
        border-left: 3px solid var(--color-scheme-text);
        padding: 1.25rem 1.5rem;
        border-radius: 0;
        margin-bottom: 2rem;
        opacity: 0.9;
      ">
        <p style="
          font-family: var(--glob-subheading-font);
          font-weight: var(--glob-subheading-weight);
          text-transform: var(--glob-subheading-text-transform);
          font-size: calc(var(--glob-text-scale-xs) * 1rem);
          letter-spacing: 0.1em;
          margin-bottom: 0.5rem;
        ">{{ section.settings.policy_heading }}</p>
        <div class="rte" style="
          font-size: calc(var(--glob-text-scale-sm) * 1rem);
          opacity: 0.75;
          line-height: 1.65;
        ">
          {{ section.settings.policy_text }}
        </div>
      </div>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_url }}" class="button">
        {{ section.settings.button_label }}
      </a>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Seating Reservations",
  "tag": "section",
  "class": "seating-reservations-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "main", "label": "White" },
        { "value": "alt", "label": "Light Gray" },
        { "value": "invert", "label": "Black" }
      ],
      "default": "invert"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Reserve Your Spot"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Picnic Table Seating"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Guaranteed seating for your group — reserve a picnic table online. Reservations are 2 hours max, unhosted, and non-refundable. Outside food, desserts, and drinks are not permitted without prior approval and fees.</p>"
    },
    {
      "type": "text",
      "id": "policy_heading",
      "label": "Policy block heading",
      "default": "Abandonment Policy"
    },
    {
      "type": "richtext",
      "id": "policy_text",
      "label": "Policy text",
      "default": "<p>All rental fees are non-refundable and do not apply to food or beverage charges. Parties must start on time. If your group has not arrived within 20 minutes of the scheduled start time, reserved tables will be considered abandoned and the reservation will be cancelled. Fees paid are non-refundable.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave blank to hide button"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "type": "seating_tier",
      "name": "Seating Tier",
      "settings": [
        {
          "type": "text",
          "id": "guest_label",
          "label": "Guest count",
          "default": "Up to 10 guests"
        },
        {
          "type": "text",
          "id": "table_count",
          "label": "Table count label",
          "default": "1 picnic table"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$100"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Seating Reservations",
      "blocks": [
        {
          "type": "seating_tier",
          "settings": {
            "guest_label": "Up to 10 guests",
            "table_count": "1 picnic table",
            "price": "$100"
          }
        },
        {
          "type": "seating_tier",
          "settings": {
            "guest_label": "Up to 20 guests",
            "table_count": "2 picnic tables",
            "price": "$200"
          }
        },
        {
          "type": "seating_tier",
          "settings": {
            "guest_label": "Up to 30 guests",
            "table_count": "3 picnic tables",
            "price": "$300"
          }
        }
      ]
    }
  ]
}
{% endschema %}
