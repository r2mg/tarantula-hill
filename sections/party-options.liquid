{% comment %}
  Section: Party Options — Rent a table / Buffet service
  Location: Tarantula Hill Brewing Co. — Book a Party page
  Add via: Online Store > Themes > Customize > Add Section

  Replaces the old "Step 1 / Step 2" stack (seating-reservations +
  party-ready-packages + house-rules + buffet-packages + tripleseat-form)
  with two independent booking options behind a chooser.

  ── How it works ────────────────────────────────────────────────────────
  - Two cards act as radio-ish toggles (aria-pressed, keyboard operable).
  - Selecting one reveals its panel, hides the other, and sets the URL hash
    (#rent-a-table / #buffet-service). The hash is read back on load.
  - BOTH Tripleseat script tags are in the DOM on page load. Panels are
    toggled, never injected, so neither embed is re-initialised. See
    HIDE_MODE in the script below if reCAPTCHA misbehaves in a hidden panel.

  ── Notes on the Tripleseat embeds (do not modify the script tags) ───────
  - Option 1 uses the legacy v1 lead form endpoint (lead_form_id).
  - Option 2 uses the newer dynamic lead form endpoint (dynamic_lead_form_id).
  - Both embeds inject an element with id="tripleseat_embed_form", so with
    both on one page that id is duplicated. All CSS below is scoped to this
    section AND to the owning panel so the two forms cannot style each other.
    The table panel is rendered first so a getElementById() lookup in the
    legacy script resolves to its own form.
  - The v1 script tag is NOT deferred here (it was in sections/tripleseat-form.liquid).
    It writes the Google reCAPTCHA <script> with document.write(), which the
    browser drops when the writing script is deferred; without defer it loads
    its own reCAPTCHA instead of relying on the buffet embed to load it.
{% endcomment %}

{%- liquid
  assign s = '#PartyOptions-' | append: section.id
  assign uid = section.id
  assign table_key = 'rent-a-table'
  assign buffet_key = 'buffet-service'
  assign active_scheme = 'color-scheme-' | append: section.settings.card_active_color_scheme
  assign rules_scheme = 'color-scheme-' | append: section.settings.rules_color_scheme
-%}

<div class="section-wrapper color-scheme-{{ section.settings.color_scheme }} section-wrapper--y-offset--padding">
  <div class="section__inner container">
    <div class="party-options" id="PartyOptions-{{ uid }}">

      {%- comment -%} ── Chooser ─────────────────────────────────────── {%- endcomment -%}
      <div class="po-chooser">
        {% if section.settings.eyebrow != blank %}
          <p class="subheading po-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="section__heading po-heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="rte po-intro">{{ section.settings.description }}</div>
        {% endif %}

        <div class="po-cards" role="group" aria-label="{{ section.settings.heading | escape }}">

          {%- comment -%} Option 1 card — rent a table {%- endcomment -%}
          <button
            type="button"
            class="po-card {{ active_scheme }}"
            data-po-option="{{ table_key }}"
            aria-pressed="true"
            aria-controls="PartyOptions-{{ uid }}-{{ table_key }}"
          >
            <span class="po-card__top">
              {% if section.settings.t_eyebrow != blank %}
                <span class="po-card__eyebrow">{{ section.settings.t_eyebrow }}</span>
              {% endif %}
              {% if section.settings.t_label != blank %}
                <span class="po-card__label">{{ section.settings.t_label }}</span>
              {% endif %}
              {% if section.settings.t_guests != blank %}
                <span class="po-card__guests">{{ section.settings.t_guests }}</span>
              {% endif %}
            </span>
            {% if section.settings.t_pitch != blank %}
              <span class="po-card__pitch">{{ section.settings.t_pitch }}</span>
            {% endif %}
            {% if section.settings.t_meta != blank %}
              <span class="po-card__meta">{{ section.settings.t_meta }}</span>
            {% endif %}
            {% if section.settings.t_button != blank %}
              <span class="button po-card__button">{{ section.settings.t_button }}</span>
            {% endif %}
          </button>

          {%- comment -%} Option 2 card — buffet service {%- endcomment -%}
          <button
            type="button"
            class="po-card"
            data-po-option="{{ buffet_key }}"
            aria-pressed="false"
            aria-controls="PartyOptions-{{ uid }}-{{ buffet_key }}"
          >
            <span class="po-card__top">
              {% if section.settings.b_eyebrow != blank %}
                <span class="po-card__eyebrow">{{ section.settings.b_eyebrow }}</span>
              {% endif %}
              {% if section.settings.b_label != blank %}
                <span class="po-card__label">{{ section.settings.b_label }}</span>
              {% endif %}
              {% if section.settings.b_guests != blank %}
                <span class="po-card__guests">{{ section.settings.b_guests }}</span>
              {% endif %}
            </span>
            {% if section.settings.b_pitch != blank %}
              <span class="po-card__pitch">{{ section.settings.b_pitch }}</span>
            {% endif %}
            {% if section.settings.b_meta != blank %}
              <span class="po-card__meta">{{ section.settings.b_meta }}</span>
            {% endif %}
            {% if section.settings.b_button != blank %}
              <span class="button po-card__button">{{ section.settings.b_button }}</span>
            {% endif %}
          </button>

          {%- comment -%}
            TODO — open question for the client, do not guess:
            a group of exactly 20 people. Option 1 says "up to 20" and
            Option 2 says "20+", so both currently claim it. Once decided,
            fix t_guests / b_guests (and the "For groups of more than 20…"
            rule) so only one side owns 20.
          {%- endcomment -%}
        </div>
      </div>

      {%- comment -%} ── Option 1 panel — rent a table ───────────────── {%- endcomment -%}
      <div
        class="po-panel po-panel--table"
        id="PartyOptions-{{ uid }}-{{ table_key }}"
        data-po-panel="{{ table_key }}"
        role="region"
        aria-label="{{ section.settings.t_heading | escape }}"
      >
        <div class="po-panel__grid">

          <div class="po-panel__details">
            {% if section.settings.t_heading != blank %}
              <h3 class="po-panel__heading">{{ section.settings.t_heading }}</h3>
            {% endif %}

            {% if section.settings.t_description != blank %}
              <div class="rte po-panel__intro">{{ section.settings.t_description }}</div>
            {% endif %}

            {%- comment -%} Seating tiers {%- endcomment -%}
            {% assign has_tiers = false %}
            {% for block in section.blocks %}
              {% if block.type == 'seating_tier' %}{% assign has_tiers = true %}{% endif %}
            {% endfor %}

            {% if has_tiers %}
              <div class="po-tiers">
                {% for block in section.blocks %}
                  {% if block.type == 'seating_tier' %}
                    <div class="po-tier" {{ block.shopify_attributes }}>
                      {% if block.settings.label != blank %}
                        <p class="po-tier__label">{{ block.settings.label }}</p>
                      {% endif %}
                      <p class="po-tier__guests">{{ block.settings.guest_label }}</p>
                      <p class="po-tier__tables">{{ block.settings.table_count }}</p>
                      <p class="po-tier__price">{{ block.settings.price }}</p>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            {%- comment -%}
              Food packages — collapsed by default.
              TODO — open question for the client, do not guess: should this
              expand inline (as built) or link out to a menu page instead?
            {%- endcomment -%}
            {%- comment -%}
              HIDDEN 2026-09-11 at the client's request — the food packages
              button and its panel are switched off for now. Flip
              show_packages back to true to restore it; the package blocks,
              copy, and styles are all left in place untouched.
            {%- endcomment -%}
            {% assign show_packages = false %}

            {% assign has_packages = false %}
            {% for block in section.blocks %}
              {% if block.type == 'package' %}{% assign has_packages = true %}{% endif %}
            {% endfor %}

            {% if show_packages and has_packages and section.settings.packages_button_label != blank %}
              <div class="po-packages">
                <button
                  type="button"
                  class="button button--variant--outline po-packages__toggle"
                  aria-expanded="false"
                  aria-controls="PartyOptions-{{ uid }}-packages"
                  data-po-packages-toggle
                  data-label-show="{{ section.settings.packages_button_label | escape }}"
                  data-label-hide="Hide food packages"
                >{{ section.settings.packages_button_label }}</button>

                <div class="po-packages__body" id="PartyOptions-{{ uid }}-packages" hidden>
                  {% if section.settings.packages_description != blank %}
                    <div class="rte po-packages__intro">{{ section.settings.packages_description }}</div>
                  {% endif %}

                  <div class="po-package-grid">
                    {% for block in section.blocks %}
                      {% if block.type == 'package' %}
                        <div class="po-package{% if block.settings.featured %} po-package--featured{% endif %}" {{ block.shopify_attributes }}>
                          {% if block.settings.badge != blank %}
                            <span class="po-package__badge">{{ block.settings.badge }}</span>
                          {% endif %}
                          <p class="po-package__name">{{ block.settings.package_name }}</p>
                          <p class="po-package__guests">{{ block.settings.guest_count }}</p>
                          <p class="po-package__price">{{ block.settings.price }}</p>
                          <div class="po-package__includes">{{ block.settings.includes | newline_to_br }}</div>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>

                  {% if section.settings.packages_footnote != blank %}
                    <div class="rte po-packages__footnote">{{ section.settings.packages_footnote }}</div>
                  {% endif %}
                </div>
              </div>
            {% endif %}

            {%- comment -%} Abandonment policy {%- endcomment -%}
            {% if section.settings.t_policy_text != blank %}
              <div class="po-policy">
                {% if section.settings.t_policy_heading != blank %}
                  <p class="po-policy__heading">{{ section.settings.t_policy_heading }}</p>
                {% endif %}
                <div class="rte po-policy__text">{{ section.settings.t_policy_text }}</div>
              </div>
            {% endif %}

            {%- comment -%} House rules — shared blocks, table scope {%- endcomment -%}
            {% assign has_table_rules = false %}
            {% for block in section.blocks %}
              {% if block.type == 'rule' and block.settings.show_on != 'buffet' %}{% assign has_table_rules = true %}{% endif %}
            {% endfor %}

            {% if has_table_rules %}
              <div class="po-rules {{ rules_scheme }}">
                {% if section.settings.rules_heading != blank %}
                  <p class="po-rules__heading">{{ section.settings.rules_heading }}</p>
                {% endif %}
                <ul class="po-rules__list">
                  {% for block in section.blocks %}
                    {% if block.type == 'rule' and block.settings.show_on != 'buffet' %}
                      <li class="po-rule" {{ block.shopify_attributes }}>
                        <span class="po-rule__mark" aria-hidden="true">
                          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="1.5,5 3.5,7.5 8.5,2.5"/>
                          </svg>
                        </span>
                        <span class="po-rule__text">{{ block.settings.rule_text }}</span>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </div>

          {%- comment -%} Tripleseat — legacy v1 table rental form {%- endcomment -%}
          <div class="po-panel__form po-form-wrap po-form-wrap--table">
            {%- comment -%} theme-check-disable RemoteAsset, ParserBlockingScript {%- endcomment -%}
            <script src="https://api.tripleseat.com/v1/leads/ts_script.js?lead_form_id={{ section.settings.t_lead_form_id }}&public_key={{ section.settings.ts_public_key }}"></script>
            {%- comment -%} theme-check-enable RemoteAsset, ParserBlockingScript {%- endcomment -%}
            <a id="tripleseat_link" class="po-form-credit" href="https://www.tripleseat.com">{{ section.settings.form_credit_text }}</a>
          </div>

        </div>
      </div>

      {%- comment -%} ── Option 2 panel — buffet service ─────────────── {%- endcomment -%}
      <div
        class="po-panel po-panel--buffet"
        id="PartyOptions-{{ uid }}-{{ buffet_key }}"
        data-po-panel="{{ buffet_key }}"
        role="region"
        aria-label="{{ section.settings.b_heading | escape }}"
        hidden
      >
        <div class="po-panel__grid">

          <div class="po-panel__details">
            {% if section.settings.b_heading != blank %}
              <h3 class="po-panel__heading">{{ section.settings.b_heading }}</h3>
            {% endif %}

            {% if section.settings.b_description != blank %}
              <div class="rte po-panel__intro">{{ section.settings.b_description }}</div>
            {% endif %}

            {%- comment -%} Buffet highlights {%- endcomment -%}
            {% assign has_highlights = false %}
            {% for block in section.blocks %}
              {% if block.type == 'buffet_highlight' %}{% assign has_highlights = true %}{% endif %}
            {% endfor %}

            {% if has_highlights %}
              <div class="po-highlights">
                {% for block in section.blocks %}
                  {% if block.type == 'buffet_highlight' %}
                    <div class="po-highlight" {{ block.shopify_attributes }}>
                      {% if block.settings.label != blank %}
                        <p class="po-highlight__label">{{ block.settings.label }}</p>
                      {% endif %}
                      {% if block.settings.value != blank %}
                        <p class="po-highlight__value">{{ block.settings.value }}</p>
                      {% endif %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            {%- comment -%} House rules — shared blocks, buffet scope {%- endcomment -%}
            {% assign has_buffet_rules = false %}
            {% for block in section.blocks %}
              {% if block.type == 'rule' and block.settings.show_on != 'table' %}{% assign has_buffet_rules = true %}{% endif %}
            {% endfor %}

            {% if has_buffet_rules %}
              <div class="po-rules {{ rules_scheme }}">
                {% if section.settings.rules_heading != blank %}
                  <p class="po-rules__heading">{{ section.settings.rules_heading }}</p>
                {% endif %}
                <ul class="po-rules__list">
                  {% for block in section.blocks %}
                    {% if block.type == 'rule' and block.settings.show_on != 'table' %}
                      <li class="po-rule" {{ block.shopify_attributes }}>
                        <span class="po-rule__mark" aria-hidden="true">
                          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="1.5,5 3.5,7.5 8.5,2.5"/>
                          </svg>
                        </span>
                        <span class="po-rule__text">{{ block.settings.rule_text }}</span>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </div>

          {%- comment -%} Tripleseat — dynamic buffet / event form {%- endcomment -%}
          <div class="po-panel__form po-form-wrap po-form-wrap--buffet">
            {%- comment -%} theme-check-disable RemoteAsset, ParserBlockingScript {%- endcomment -%}
            <script src="https://api.tripleseat.com/ts/dynamic_leads/ts_script.js?dynamic_lead_form_id={{ section.settings.b_lead_form_id }}&public_key={{ section.settings.ts_public_key }}"></script>
            {%- comment -%} theme-check-enable RemoteAsset, ParserBlockingScript {%- endcomment -%}
            <a id="tripleseat_link_buffet" class="po-form-credit" href="https://www.tripleseat.com">{{ section.settings.form_credit_text }}</a>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>

<style>
  /* ══ Chooser ═════════════════════════════════════════════════════════ */
  {{ s }} {
    --po-focus: var(--color-scheme-text);
    scroll-margin-top: 5rem;
  }

  {{ s }} .po-eyebrow {
    margin-bottom: 0.5rem;
    font-size: calc(var(--glob-text-scale-xs) * 1rem);
  }

  {{ s }} .po-heading {
    font-family: var(--glob-heading-font);
    font-weight: var(--glob-heading-font-weight);
    text-transform: var(--glob-heading-transform);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.05;
    margin-bottom: 0.75rem;
  }

  {{ s }} .po-intro {
    max-width: 640px;
    margin-bottom: 2.5rem;
    opacity: 0.7;
    font-size: calc(var(--glob-text-scale-sm) * 1rem);
    line-height: 1.65;
  }

  {{ s }} .po-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  {{ s }} .po-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    width: 100%;
    margin: 0;
    padding: 2rem 1.75rem;
    text-align: left;
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid var(--color-scheme-border);
    border-radius: 0;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  {{ s }} .po-card:hover {
    border-color: var(--color-scheme-text);
  }

  /* Selected card carries its own colour scheme (see card_active_color_scheme),
     so everything inside it — including the theme .button — flips with it. */
  {{ s }} .po-card[aria-pressed="true"] {
    background: var(--color-scheme-background);
    color: var(--color-scheme-text);
    border-color: var(--color-scheme-background);
  }

  /* The notch: a square rotated 45deg straddling the bottom edge, so the
     card's outline reads as continuing down into a point at the panel. */
  {{ s }} .po-card[aria-pressed="true"]::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 15px;
    height: 15px;
    transform: translate(-50%, 50%) rotate(45deg);
    background: var(--color-scheme-background);
    border-right: 1px solid var(--color-scheme-border);
    border-bottom: 1px solid var(--color-scheme-border);
  }

  /* Focus ring uses the section's text colour, not the selected card's
     inverted one, so it stays visible against the page. */
  {{ s }} .po-card:focus-visible {
    outline: 2px solid var(--po-focus);
    outline-offset: 3px;
  }

  {{ s }} .po-card__top {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  {{ s }} .po-card__eyebrow {
    font-family: var(--glob-subheading-font);
    font-weight: var(--glob-subheading-weight);
    text-transform: var(--glob-subheading-text-transform);
    font-size: calc(var(--glob-text-scale-xs) * 0.9rem);
    letter-spacing: 0.18em;
    opacity: 0.45;
    margin-bottom: 0.15rem;
  }

  {{ s }} .po-card__label {
    font-family: var(--glob-heading-font);
    font-weight: var(--glob-heading-font-weight);
    text-transform: var(--glob-heading-transform);
    font-size: clamp(1.25rem, 2.5vw, 1.6rem);
    line-height: 1.1;
  }

  {{ s }} .po-card__guests {
    font-family: var(--glob-subheading-font);
    font-weight: var(--glob-subheading-weight);
    text-transform: var(--glob-subheading-text-transform);
    font-size: calc(var(--glob-text-scale-xs) * 1rem);
    letter-spacing: 0.15em;
    opacity: 0.5;
  }

  {{ s }} .po-card__pitch {
    font-size: calc(var(--glob-text-scale-sm) * 1rem);
    line-height: 1.55;
    opacity: 0.8;
  }

  {{ s }} .po-card__meta {
    font-family: var(--glob-subheading-font);
    font-weight: var(--glob-subheading-weight);
    text-transform: var(--glob-subheading-text-transform);
    font-size: calc(var(--glob-text-scale-xs) * 1rem);
    letter-spacing: 0.1em;
    opacity: 0.55;
  }

  {{ s }} .po-card__button {
    margin-top: 0.75rem;
    pointer-events: none;
  }

  /* ══ Panels ══════════════════════════════════════════════════════════ */
  {{ s }} .po-panel[hidden] {
    display: none;
  }

  /* Fallback hide mode — see HIDE_MODE in the script below. Keeps the panel
     in the layout (so embedded widgets can measure themselves) while making
     it invisible and untabbable. */
  {{ s }} .po-panel--offscreen {
    visibility: hidden;
    position: absolute;
    left: -9999px;
    top: 0;
    width: 100%;
    pointer-events: none;
  }

  {{ s }} .po-panel {
    margin-top: 3rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    {{ s }} .po-panel--enter {
      animation: po-panel-enter 180ms ease-out;
    }
  }

  @keyframes po-panel-enter {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  {{ s }} .po-panel__grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 4rem;
    align-items: start;
  }

  {{ s }} .po-panel__heading {
    font-family: var(--glob-heading-font);
    font-weight: var(--glob-heading-font-weight);
    text-transform: var(--glob-heading-transform);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.05;
    margin-bottom: 0.75rem;
  }

  {{ s }} .po-panel__intro {
    opacity: 0.7;
    font-size: calc(var(--glob-text-scale-sm) * 1rem);
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  {{ s }} .po-panel__intro p + p {
    margin-top: 0.85rem;
  }

  /* ══ Seating tiers ═══════════════════════════════════════════════════ */
  {{ s }} .po-tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  {{ s }} .po-tier {
    border: 1px solid var(--color-scheme-border);
    padding: 1.5rem 1.25rem;
    text-align: center;
  }

  {{ s }} .po-tier__label {
    font-family: var(--glob-subheading-font);
    font-weight: var(--glob-subheading-weight);
    text-transform: var(--glob-subheading-text-transform);
    font-size: calc(var(--glob-text-scale-xs) * 1rem);
    letter-spacing: 0.15em;
    opacity: 0.5;
    margin-bottom: 0.6rem;
  }

  {{ s }} .po-tier__guests {
    font-family: var(--glob-heading-font);
    font-weight: var(--glob-heading-font-weight);
    text-transform: var(--glob-heading-transform);
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  {{ s }} .po-tier__tables {
    font-family: var(--glob-subheading-font);
    font-weight: var(--glob-subheading-weight);
    text-transform: var(--glob-subheading-text-transform);
    font-size: calc(var(--glob-text-scale-xs) * 1rem);
    letter-spacing: 0.1em;
    opacity: 0.55;
    margin-bottom: 1rem;
  }

  {{ s }} .po-tier__price {
    font-family: var(--glob-heading-font);
    font-weight: var(--glob-heading-font-weight);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1;
  }

  /* ══ Food packages (collapsible) ═════════════════════════════════════ */
  {{ s }} .po-packages {
    margin-bottom: 2rem;
  }

  {{ s }} .po-packages__body[hidden] {
    display: none;
  }

  {{ s }} .po-packages__body {
    margin-top: 1.5rem;
  }

  {{ s }} .po-packages__intro {
    font-size: calc(var(--glob-text-scale-sm) * 1rem);
    line-height: 1.65;
    opacity: 0.7;
    margin-bottom: 1.5rem;
  }

  {{ s }} .po-package-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  {{ s }} .po-package {
    border: 1px solid var(--color-scheme-border);
    padding: 1.75rem;
    position: relative;
  }

  {{ s }} .po-package--featured {
    border-width: 2px;
    border-color: var(--color-scheme-text);
  }

  {{ s }} .po-package__badge {
    display: block;
