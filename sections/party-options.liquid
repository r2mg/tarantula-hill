    border-radius: 0 !important;
    border: none !important;
    padding: 0.5rem !important;
  }

  .ui-datepicker .ui-datepicker-title {
    font-family: var(--glob-heading-font) !important;
    font-weight: var(--glob-heading-font-weight) !important;
    text-transform: var(--glob-heading-transform) !important;
    font-size: calc(var(--glob-text-scale-xs) * 1rem) !important;
    letter-spacing: 0.1em !important;
  }

  .ui-datepicker td.ui-state-active a,
  .ui-datepicker td .ui-state-active {
    background: #282828 !important;
    color: #fff !important;
    border: none !important;
    border-radius: 0 !important;
  }

  .ui-datepicker td a:hover {
    background: rgba(40, 40, 40, 0.08) !important;
    border-radius: 0 !important;
  }

  .ui-datepicker .ui-datepicker-prev,
  .ui-datepicker .ui-datepicker-next {
    border-radius: 0 !important;
    top: 4px !important;
  }

  /* ══ Responsive ══════════════════════════════════════════════════════ */
  @media (max-width: 900px) {
    {{ s }} .po-panel__grid {
      grid-template-columns: 1fr !important;
      gap: 2.5rem !important;
    }

    {{ s }} .po-form-wrap--table #tripleseat_embed_form tr.row_first_name:not([style*="display: none"]),
    {{ s }} .po-form-wrap--table #tripleseat_embed_form tr.row_time:not([style*="display: none"]),
    {{ s }} .po-form-wrap--buffet .tripleseat-dlf-name-fields {
      grid-template-columns: 1fr !important;
      gap: 0 !important;
    }
  }

  @media (max-width: 749px) {
