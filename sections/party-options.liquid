<script>
  (function () {
    var root = document.getElementById('PartyOptions-{{ uid }}');
    if (!root) return;

    /* 'attribute' hides the inactive panel with [hidden].
       Switch to 'offscreen' if a third-party widget inside a hidden panel
       (Tripleseat's reCAPTCHA) fails to render or size itself — that mode
       keeps the panel laid out but invisible. */
    var HIDE_MODE = 'attribute';

    var DEFAULT_OPTION = '{{ table_key }}';
    var ACTIVE_SCHEME = '{{ active_scheme }}';
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var cards = root.querySelectorAll('[data-po-option]');
    var panels = root.querySelectorAll('[data-po-panel]');

    function showPanel(panel, show) {
      if (HIDE_MODE === 'offscreen') {
        panel.hidden = false;
        panel.classList.toggle('po-panel--offscreen', !show);
        panel.setAttribute('aria-hidden', show ? 'false' : 'true');
      } else {
        panel.classList.remove('po-panel--offscreen');
        panel.hidden = !show;
        panel.removeAttribute('aria-hidden');
      }
    }

    function isKnown(name) {
      for (var i = 0; i < panels.length; i++) {
        if (panels[i].getAttribute('data-po-panel') === name) return true;
      }
      return false;
    }

    function select(name, updateHash, animate) {
      if (!isKnown(name)) name = DEFAULT_OPTION;

      for (var i = 0; i < cards.length; i++) {
        var active = cards[i].getAttribute('data-po-option') === name;
        cards[i].setAttribute('aria-pressed', active ? 'true' : 'false');
        if (ACTIVE_SCHEME) cards[i].classList.toggle(ACTIVE_SCHEME, active);
      }

      for (var j = 0; j < panels.length; j++) {
        var show = panels[j].getAttribute('data-po-panel') === name;
        showPanel(panels[j], show);
        if (show && animate && !reduceMotion) replay(panels[j]);
      }

      if (updateHash && window.history && window.history.replaceState) {
        window.history.replaceState(null, '', '#' + name);
      } else if (updateHash) {
        window.location.hash = name;
      }
    }

    /* Restart the enter animation on a panel that may already carry the class. */
    function replay(panel) {
      panel.classList.remove('po-panel--enter');
      void panel.offsetWidth;
      panel.classList.add('po-panel--enter');
    }

    root.addEventListener('animationend', function (event) {
      if (event.animationName === 'po-panel-enter') {
        event.target.classList.remove('po-panel--enter');
      }
    });

    for (var i = 0; i < cards.length; i++) {
      cards[i].addEventListener('click', function (event) {
        select(event.currentTarget.getAttribute('data-po-option'), true, true);
      });
    }

    window.addEventListener('hashchange', function () {
      var name = window.location.hash.replace('#', '');
      if (isKnown(name)) select(name, false, true);
    });

    /* Food packages disclosure */
    var toggle = root.querySelector('[data-po-packages-toggle]');
    if (toggle) {
      var body = document.getElementById(toggle.getAttribute('aria-controls'));
      toggle.addEventListener('click', function () {
        var open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
        toggle.textContent = open
          ? toggle.getAttribute('data-label-show')
          : toggle.getAttribute('data-label-hide');
        if (body) body.hidden = open;
      });
    }

    /* Theme editor: reveal the panel that owns the block being edited. */
    if (window.Shopify && window.Shopify.designMode) {
      document.addEventListener('shopify:block:select', function (event) {
        var panel = event.target.closest ? event.target.closest('[data-po-panel]') : null;
        if (panel && root.contains(panel)) select(panel.getAttribute('data-po-panel'), false);
      });
    }

    var initial = window.location.hash.replace('#', '');
    select(initial || DEFAULT_OPTION, false, false);

    /* Deep link: land on the chooser so both options and the selected one
       are visible, rather than dropping the visitor inside the panel. */
    if (isKnown(initial)) {
      requestAnimationFrame(function () {
        root.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      });
    }
  })();
</script>

