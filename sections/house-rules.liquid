{% comment %}
  Section: House Rules — Booking Policies
  Location: Tarantula Hill Brewing Co. — Book a Party page
  Add via: Online Store > Themes > Customize > Add Section
{% endcomment %}

<div class="section-wrapper color-scheme-{{ section.settings.color_scheme }} section-wrapper--y-offset--padding">
  <div class="section__inner container">

    {% if section.settings.eyebrow != blank %}
      <p class="subheading" style="margin-bottom: 0.5rem; font-size: calc(var(--glob-text-scale-xs) * 1rem);">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="section__heading" style="
        font-family: var(--glob-heading-font);
        font-weight: var(--glob-heading-font-weight);
        text-transform: var(--glob-heading-transform);
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        line-height: 1.05;
        margin-bottom: 0.75rem;
      ">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="rte" style="
        max-width: 640px;
        margin-bottom: 2rem;
        opacity: 0.7;
        font-size: calc(var(--glob-text-scale-sm) * 1rem);
        line-height: 1.65;
      ">
        {{ section.settings.description }}
      </div>
    {% endif %}

    <div style="
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 0;
    ">
      {% for block in section.blocks %}
        {% if block.type == 'rule' %}
          <div {{ block.shopify_attributes }} style="
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            padding: 1.1rem 0;
            border-bottom: 1px solid var(--color-scheme-border);
            font-size: calc(var(--glob-text-scale-sm) * 1rem);
            line-height: 1.55;
          ">
            <span style="
              display: inline-flex;
              align-items: center;
              justify-content: center;
              width: 20px;
              height: 20px;
              min-width: 20px;
              border: 1.5px solid currentColor;
              border-radius: 0;
              margin-top: 0.15rem;
              opacity: 0.9;
            ">
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="1.5,5 3.5,7.5 8.5,2.5"/>
              </svg>
            </span>
            <span style="opacity: 0.8;">{{ block.settings.rule_text }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.button_label != blank %}
      <div style="margin-top: 2rem;">
        <a href="{{ section.settings.button_url }}" class="button">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "House Rules",
  "tag": "section",
  "class": "house-rules-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "main", "label": "White" },
        { "value": "alt", "label": "Light Gray" },
        { "value": "invert", "label": "Black" }
      ],
      "default": "alt"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Good to Know"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "House Rules"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A few things to keep in mind before you book.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave blank to hide button"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "type": "rule",
      "name": "Rule",
      "settings": [
        {
          "type": "text",
          "id": "rule_text",
          "label": "Rule text",
          "default": "Order party packages at least 2 weeks in advance"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "House Rules",
      "blocks": [
        {
          "type": "rule",
          "settings": { "rule_text": "Order party packages at least 2 weeks in advance" }
        },
        {
          "type": "rule",
          "settings": { "rule_text": "Outside food, desserts, and drinks require preapproval and may incur fees" }
        },
        {
          "type": "rule",
          "settings": { "rule_text": "Seating reservations are 2-hour max and non-refundable" }
        },
        {
          "type": "rule",
          "settings": { "rule_text": "Pet policy applies to all reserved seating — indoor rentals are pet-free" }
        },
        {
          "type": "rule",
          "settings": { "rule_text": "Parties must start on time — no-shows within 20 minutes forfeit their reservation" }
        },
        {
          "type": "rule",
          "settings": { "rule_text": "For groups of 25 or more, contact us for a custom catering quote" }
        }
      ]
    }
  ]
}
{% endschema %}
