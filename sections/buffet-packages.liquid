{% comment %}
  Section: Buffet Packages — Large Event Catering
  Location: Tarantula Hill Brewing Co. — Book a Party page
  Add via: Online Store > Themes > Customize > Add Section
{% endcomment %}

<div class="section-wrapper color-scheme-{{ section.settings.color_scheme }} section-wrapper--y-offset--padding">
  <div class="section__inner container">

    <div class="buffet-layout">
      {%- comment -%} Left: content + highlights (sticky) {%- endcomment -%}
      <div class="buffet-header">
        {% if section.settings.eyebrow != blank %}
          <p class="subheading" style="margin-bottom: 0.5rem; font-size: calc(var(--glob-text-scale-xs) * 1rem);">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="section__heading" style="
            font-family: var(--glob-heading-font);
            font-weight: var(--glob-heading-font-weight);
            text-transform: var(--glob-heading-transform);
            font-size: clamp(1.75rem, 4vw, 2.5rem);
            line-height: 1.05;
            margin-bottom: 0.75rem;
          ">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="rte" style="
            margin-bottom: 2rem;
            opacity: 0.7;
            font-size: calc(var(--glob-text-scale-sm) * 1rem);
            line-height: 1.65;
          ">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.lead_time != blank %}
          <p style="
            font-family: var(--glob-subheading-font);
            font-weight: var(--glob-subheading-weight);
            text-transform: var(--glob-subheading-text-transform);
            font-size: calc(var(--glob-text-scale-xs) * 1rem);
            letter-spacing: 0.15em;
            opacity: 0.55;
            margin-bottom: 2rem;
          ">{{ section.settings.lead_time }}</p>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_url }}" class="button">
            {{ section.settings.button_label }}
          </a>
        {% endif %}

        {%- comment -%} Highlights below the button {%- endcomment -%}
        {% for block in section.blocks %}
          {% if block.type == 'highlight' %}
            <div {{ block.shopify_attributes }} style="
              padding: 1.25rem 0;
              border-bottom: 1px solid var(--color-scheme-border);
              {% if forloop.first %}border-top: 1px solid var(--color-scheme-border); margin-top: 2rem;{% endif %}
            ">
              {% if block.settings.label != blank %}
                <p style="
                  font-family: var(--glob-subheading-font);
                  font-weight: var(--glob-subheading-weight);
                  text-transform: var(--glob-subheading-text-transform);
                  font-size: calc(var(--glob-text-scale-xs) * 1rem);
                  letter-spacing: 0.15em;
                  opacity: 0.5;
                  margin-bottom: 0.3rem;
                ">{{ block.settings.label }}</p>
              {% endif %}
              {% if block.settings.value != blank %}
                <p style="
                  font-size: calc(var(--glob-text-scale-sm) * 1rem);
                  line-height: 1.5;
                  opacity: 0.85;
                ">{{ block.settings.value }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {%- comment -%} Right: Tripleseat dynamic form embed {%- endcomment -%}
      <div class="ts-buffet-embed-wrap">
        {%- comment -%} theme-check-disable RemoteAsset {%- endcomment -%}
        <script src="https://api.tripleseat.com/ts/dynamic_leads/ts_script.js?dynamic_lead_form_id=2306&public_key=5b4725353b4a6782d9885222a1964f52f496eda8"></script>
        {%- comment -%} theme-check-enable RemoteAsset {%- endcomment -%}
        <a id="tripleseat_link_buffet" href="https://www.tripleseat.com">Private Event Software powered by Tripleseat</a>
      </div>

    </div>

  </div>
</div>

