{% comment %}
  Section: Party Ready Packages
  Location: Tarantula Hill Brewing Co. — Book a Party page
  Add via: Online Store > Themes > Customize > Add Section
{% endcomment %}

<div class="section-wrapper color-scheme-{{ section.settings.color_scheme }} section-wrapper--y-offset--padding">
  <div class="section__inner container">

    {% if section.settings.eyebrow != blank %}
      <p class="subheading" style="margin-bottom: 0.5rem; font-size: calc(var(--glob-text-scale-xs) * 1rem);">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="section__heading" style="
        font-family: var(--glob-heading-font);
        font-weight: var(--glob-heading-font-weight);
        text-transform: var(--glob-heading-transform);
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        line-height: 1.05;
        margin-bottom: 0.75rem;
      ">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="rte" style="
        max-width: 640px;
        margin-bottom: 2.5rem;
        opacity: 0.7;
        font-size: calc(var(--glob-text-scale-sm) * 1rem);
        line-height: 1.65;
      ">
        {{ section.settings.description }}
      </div>
    {% endif %}

    {% if section.settings.show_price_note %}
      <p style="
        display: inline-block;
        border: 1px solid currentColor;
        opacity: 0.5;
        font-size: 0.7rem;
        font-family: var(--glob-subheading-font);
        font-weight: var(--glob-subheading-weight);
        text-transform: var(--glob-subheading-text-transform);
        letter-spacing: 0.15em;
        padding: 0.3rem 0.9rem;
        margin-bottom: 2rem;
      ">
        {{ section.settings.price_note_text }}
      </p>
    {% endif %}

    <div style="
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
      margin-bottom: 1.5rem;
    ">
      {% for block in section.blocks %}
        {% if block.type == 'package' %}
          <div {{ block.shopify_attributes }} style="
            border: 1px solid currentColor;
            border-color: rgba({% if section.settings.color_scheme == 'invert' %}255,255,255{% else %}40,40,40{% endif %}, {% if block.settings.featured %}1{% else %}0.15{% endif %});
            {% if block.settings.featured %}border-width: 2px;{% endif %}
            padding: 2rem;
            border-radius: 0;
            position: relative;
          ">
            {% if block.settings.badge != blank %}
              <span style="
                display: inline-block;
                background: var(--color-scheme-button-background);
                color: var(--color-scheme-button-text);
                font-family: var(--glob-button-font);
                font-weight: var(--glob-button-weight);
                font-size: 0.65rem;
                letter-spacing: 0.15em;
                text-transform: var(--glob-button-text-transform);
                padding: 0.25rem 0.75rem;
                border-radius: 0;
                margin-bottom: 1rem;
                display: block;
                width: fit-content;
              ">{{ block.settings.badge }}</span>
            {% endif %}

            <p style="
              font-family: var(--glob-heading-font);
              font-weight: var(--glob-heading-font-weight);
              text-transform: var(--glob-heading-transform);
              font-size: 1rem;
              letter-spacing: 0.05em;
              margin-bottom: 0.25rem;
            ">{{ block.settings.package_name }}</p>

            <p style="
              font-family: var(--glob-subheading-font);
              font-weight: var(--glob-subheading-weight);
              text-transform: var(--glob-subheading-text-transform);
              font-size: 0.65rem;
              letter-spacing: 0.15em;
              opacity: 0.5;
              margin-bottom: 1.25rem;
            ">{{ block.settings.guest_count }}</p>

            <p style="
              font-family: var(--glob-heading-font);
              font-weight: var(--glob-heading-font-weight);
              font-size: clamp(2rem, 5vw, 2.5rem);
              line-height: 1;
              margin-bottom: 1.5rem;
            ">{{ block.settings.price }}</p>

            <div style="
              border-top: 1px solid rgba({% if section.settings.color_scheme == 'invert' %}255,255,255{% else %}40,40,40{% endif %}, 0.12);
              padding-top: 1rem;
              font-size: calc(var(--glob-text-scale-sm) * 1rem);
              line-height: 1.9;
              opacity: 0.75;
            ">
              {{ block.settings.includes | newline_to_br }}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.footnote != blank %}
      <p style="
        font-size: calc(var(--glob-text-scale-xs) * 1rem);
        opacity: 0.5;
        font-style: italic;
        max-width: 640px;
        line-height: 1.6;
        margin-bottom: 2rem;
      ">{{ section.settings.footnote }}</p>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_url }}" class="button">
        {{ section.settings.button_label }}
      </a>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Party Ready Packages",
  "tag": "section",
  "class": "party-ready-packages-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "main", "label": "White" },
        { "value": "alt", "label": "Light Gray" },
        { "value": "invert", "label": "Black" }
      ],
      "default": "main"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Party Ready Packages"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Grab-and-Go Catering"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Perfect for smaller crews of up to 20. We prep everything fresh and have it ready for pickup — no staff, no setup, just great food. Order at least 2 weeks ahead and you're set.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_price_note",
      "label": "Show pricing year note",
      "default": true
    },
    {
      "type": "text",
      "id": "price_note_text",
      "label": "Pricing note text",
      "default": "2026 Pricing — Reflects 5% Increase"
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote / disclaimer",
      "default": "<p>For groups of 25 or more, please use the catering inquiry form below for a custom quote. All packages are unhosted/unstaffed. Pricing shown does not include tax and gratuity.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book Your Event"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "type": "package",
      "name": "Package",
      "settings": [
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured (bold border)",
          "default": false
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge label (optional)",
          "info": "e.g. 'Best Value' — leave blank to hide"
        },
        {
          "type": "text",
          "id": "package_name",
          "label": "Package name",
          "default": "Package One"
        },
        {
          "type": "text",
          "id": "guest_count",
          "label": "Guest count label",
          "default": "Up to 10 guests"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$195"
        },
        {
          "type": "textarea",
          "id": "includes",
          "label": "What's included (one item per line)",
          "default": "4 pizzas\n4 bites\n2 Caesar salads"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Party Ready Packages",
      "blocks": [
        {
          "type": "package",
          "settings": {
            "package_name": "Package One",
            "guest_count": "Up to 10 guests",
            "price": "$195",
            "includes": "4 pizzas\n4 bites\n2 Caesar salads",
            "featured": false
          }
        },
        {
          "type": "package",
          "settings": {
            "package_name": "Package Two",
            "guest_count": "Up to 20 guests",
            "price": "$340",
            "includes": "8 pizzas\n8 bites\n3 Caesar salads",
            "featured": true,
            "badge": "Best Value"
          }
        }
      ]
    }
  ]
}
{% endschema %}
