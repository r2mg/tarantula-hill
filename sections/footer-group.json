max-width: 100%;\n  }\n  \n  .hours-item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    padding: 0.5rem;\n    min-width: auto;\n  }\n  \n  .day {\n    font-weight: 600;\n    font-size: 1rem;\n    margin-bottom: 0.25rem;\n  }\n  \n  .time {\n    font-weight: 400;\n    font-size: 0.9rem;\n    margin-left: 0;\n  }\n  \n  .brewery-hours__note {\n    margin-top: 1rem;\n    font-style: italic;\n    font-size: 0.875rem;\n    opacity: 0.8;\n    text-align: center;\n  }\n  \n  /* Mobile Responsive */\n  @media screen and (max-width: 768px) {\n    .brewery-hours-section {\n      padding: 0;\n    }\n    \n    .hours-list {\n      gap: 1rem;\n    }\n    \n    .day {\n      font-size: 0.9rem;\n    }\n    \n    .time {\n      font-size: 0.8rem;\n    }\n  }\n  \n  @media screen and (max-width: 480px) {\n    .hours-list {\n      gap: 0.75rem;\n    }\n    \n    .day {\n      font-size: 0.85rem;\n    }\n    \n    .time {\n      font-size: 0.75rem;\n    }\n  }\n</style>"
