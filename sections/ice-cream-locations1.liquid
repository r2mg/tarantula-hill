      "default": "Two Locations, One Obsession"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "info": "Leave blank to hide"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Location",
      "limit": 2,
      "settings": [
        {
          "type": "header",
          "content": "Location Info"
        },
        {
          "type": "text",
          "id": "location_name",
          "label": "Location name",
          "default": "Thousand Oaks"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (optional)",
          "info": "e.g. 'Now Open', 'New Location' — leave blank to hide"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Location photo"
        },
        {
          "type": "header",
          "content": "Address"
        },
        {
          "type": "textarea",
