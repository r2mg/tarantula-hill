          "content": "Hours"
        },
        {
          "type": "text",
          "id": "hours_mon",
          "label": "Monday",
          "default": "3PM – 10PM"
        },
        {
          "type": "text",
          "id": "hours_tue",
          "label": "Tuesday",
          "default": "12PM – 10PM"
        },
        {
          "type": "text",
          "id": "hours_wed",
          "label": "Wednesday",
          "default": "12PM – 10PM"
        },
        {
          "type": "text",
          "id": "hours_thu",
          "label": "Thursday",
          "default": "12PM – 10PM"
        },
        {
          "type": "text",
          "id": "hours_fri",
          "label": "Friday",
          "default": "12PM – 1AM"
        },
        {
          "type": "text",
          "id": "hours_sat",
          "label": "Saturday",
          "default": "12PM – 1AM"
        },
        {
          "type": "text",
          "id": "hours_sun",
          "label": "Sunday",
          "default": "12PM – 10PM"
        },
        {
          "type": "text",
          "id": "hours_note",
          "label": "Hours note",
          "info": "Optional — e.g. 'Hours may vary on holidays'"
        },
        {
          "type": "header",
          "content": "Call to Action"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "info": "Leave blank to hide button"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ice Cream Locations",
      "blocks": [
        {
          "type": "location",
          "settings": {
            "location_name": "Thousand Oaks",

            "address": "2175 Tapo Canyon Rd\nThousand Oaks, CA 91362",
            "phone": "(805) 555-0100",
            "hours_mon": "3PM – 10PM",
            "hours_tue": "12PM – 10PM",
            "hours_wed": "12PM – 10PM",
            "hours_thu": "12PM – 10PM",
            "hours_fri": "12PM – 1AM",
            "hours_sat": "12PM – 1AM",
            "hours_sun": "12PM – 10PM",
            "button_label": "Get Directions",
            "button_url": ""
          }
