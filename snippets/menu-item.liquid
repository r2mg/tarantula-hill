{%- comment -%}
  Renders one menu row for the Menu section.
  Accepts: item_name, item_price, item_desc, item_mods
  item_mods is a '~|~'-joined list of modifier lines ("Side | Ranch", or
  "| Comes with ranch" to render with no label).
{%- endcomment -%}
<div class="menu-item">
  <div class="menu-item__top">
    <span class="menu-item__name">{{ item_name }}</span>
    <span class="menu-item__dots" aria-hidden="true"></span>
    <span class="menu-item__price">{{ item_price }}</span>
  </div>
  {%- if item_desc != blank -%}<p class="menu-item__desc">{{ item_desc }}</p>{%- endif -%}
  {%- if item_mods != blank -%}
    {%- assign menu_item_mods = item_mods | split: '~|~' -%}
    {%- for mod in menu_item_mods -%}
      {%- assign mod_text = mod | strip -%}
      {%- assign mod_first = mod_text | slice: 0 -%}
      {%- if mod_first == '|' -%}
        {%- assign mod_text = mod_text | remove_first: '|' | strip -%}
      {%- endif -%}
      {%- if mod_text != blank -%}<p class="menu-item__mod">{{ mod_text }}</p>{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
</div>
