      "type": "image-with-text",
      "blocks": {
        "heading_MiTHeq": {
          "type": "heading",
          "settings": {
            "heading_text": "OUR PURPOSE",
            "heading_animation": true,
            "heading_size": "h1"
          }
        },
        "description_nN4en7": {
          "type": "description",
          "settings": {
            "text_content": "<p>Tarantula Hill Brewing Co. exists to create exceptional craft beer and artisan food experiences that bring communities together. From our flagship location in Thousand Oaks to our expanded brewing operations in San Marcos, we're committed to brewing award-winning beer using traditional methods and the finest ingredients. Our goal is simple: craft quality products that celebrate the art of brewing while fostering connections through great beer and food.</p>",
            "enlarge_text": false
          }
        }
      },
