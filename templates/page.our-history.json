    "scrolling_image_reveal_JgGULh": {
      "type": "scrolling-image-reveal",
      "blocks": {
        "image_6cdDLU": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/THill_EK_041125_1889.jpg",
            "image_ratio": "auto",
            "link": "",
            "subheading_text": "2019",
            "heading_text": "The Launch",
            "heading_size": "h4",
            "text_content": "After years of planning by five Thousand Oaks High School Class of '91 friends, Tarantula Hill Brewing Co. officially opened in July 2019 as Thousand Oaks' first brewery. The 24,000-square-foot facility began serving craft beer, Neapolitan pizza, and handmade ice cream to an enthusiastic community.",
            "color_scheme": ""
          }
        },
        "image_etpaFh": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/THill_EK_041125_1870.jpg",
            "image_ratio": "auto",
            "link": "",
            "subheading_text": "2020",
            "heading_text": "Resilience Through Challenge",
            "heading_size": "h4",
            "text_content": "Like other breweries nationwide, Tarantula Hill faced unprecedented challenges in 2020. But our community had our backs. We pivoted to self-distribution, bringing our craft beer directly to local neighborhoods and building deeper connections with the people who matter most. Thanks to incredible community support, we not only stayed open but grew stronger, proving that great beer and loyal customers make an unbeatable combination.",
            "color_scheme": ""
          }
        },
        "image_8w47BV": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/THill_EK_091824_0226.jpg",
            "image_ratio": "auto",
            "link": "",
            "subheading_text": "2021",
            "heading_text": "Growing Recognition",
            "heading_size": "h4",
            "text_content": "Stone Distributing added Tarantula Hill to its prestigious portfolio of over 40 breweries, significantly expanding distribution reach. This partnership marked an important milestone in the brewery's growth and recognition within the craft beer industry.",
            "color_scheme": ""
          }
        },
        "image_g9TkYj": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/THill_EK_102224_1047.jpg",
            "image_ratio": "auto",
            "link": "",
            "subheading_text": "2022",
            "heading_text": "Award-Winning Excellence",
            "heading_size": "h4",
            "text_content": "Tarantula Hill earned its first Great American Beer Festival gold medal with \"Who's That Brown\" in the American-Style Brown Ale category. This prestigious award validated our brewery's commitment to exceptional brewing quality on a national stage.",
            "color_scheme": ""
          }
        },
        "image_njebJD": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/THill_EK_041125_1930.jpg",
            "image_ratio": "auto",
            "link": "",
            "subheading_text": "2023",
            "heading_text": "Continued Innovation",
            "heading_size": "h4",
            "text_content": "The brewery continued developing its reputation for innovative brewing and community engagement. Brewmaster Mike Richmond and Head Brewer Dante Tomei focused on expanding our beer portfolio while maintaining the family-friendly atmosphere that made us a local favorite.",
            "color_scheme": ""
          }
        },
        "image_EnPJJA": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/THill_EK_073024_8697.jpg",
            "image_ratio": "portrait",
            "link": "",
            "subheading_text": "2024",
            "heading_text": "Major Expansion",
            "heading_size": "h4",
            "text_content": "Tarantula Hill made a significant expansion by taking over brewing operations at Draft Republic's San Marcos facility in March, allowing for increased production capacity of 5,500 barrels. We brought on brewing veteran Tyler Potter as head brewer of our San Marcos facility. This strategic move positioned the brewery for continued growth throughout Southern California.",
            "color_scheme": ""
          }
        },
        "image_EjawrB": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/THill_EK_073024_8555.jpg",
            "image_ratio": "auto",
            "link": "",
            "subheading_text": "2025",
            "heading_text": "CONTINUED GROWTH",
            "heading_size": "h4",
            "text_content": "With both Thousand Oaks and San Marcos locations operational, Tarantula Hill continues to grow as a premier craft brewery, serving an ever-expanding community of beer enthusiasts throughout the region.",
            "color_scheme": ""
          }
        },
        "image_Kwc9zQ": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/THill_EK_062825_2650.png",
            "image_ratio": "auto",
            "link": "",
            "subheading_text": "2026",
            "heading_text": "LOOKING FORWARD",
            "heading_size": "h4",
            "text_content": "We're transforming The Backyard into something special - a premier outdoor venue featuring expanded seating, a dedicated music stage, and a full outdoor bar. This new space will establish Tarantula Hill as Thousand Oaks' go-to destination for live music, combining our craft beer with unforgettable performances. Construction is underway, and we can't wait to welcome you to our biggest evolution yet.",
            "color_scheme": ""
          }
        }
      },
