2000/svg\">\n          <path d=\"M21 15V19C21 19.5304 20.7893 20.0391 20.4142 20.4142C20.0391 20.7893 19.5304 21 19 21H5C4.46957 21 3.96086 20.7893 3.58579 20.4142C3.21071 20.0391 3 19.5304 3 19V15\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          <polyline points=\"7,10 12,15 17,10\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          <line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n        Download Logo Pack\n      </a>\n    </div>\n    \n    <div class=\"press-kit__contact\">\n      For media inquiries: <strong>joshua@thillbc.com</strong>\n    </div>\n  </div>\n</div>\n\n<style>\n  .press-kit-section {\n    padding: 80px 0;\n    background-color: #f8f8f8;\n    color: #333333;\n    font-family: 'Poppins', sans-serif;\n  }\n  \n  .press-kit-container {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0 20px;\n    text-align: center;\n  }\n  \n  .press-kit__heading {\n    font-family: 'Poppins Black', 'Poppins', sans-serif;\n    font-weight: 900;\n    font-size: 48px;\n    margin-bottom: 20px;\n    color: #1a1a1a;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n  }\n  \n  .press-kit__description {\n    font-family: 'Poppins', sans-serif;\n    font-size: 18px;\n    margin-bottom: 40px;\n    max-width: 600px;\n    margin-left: auto;\n    margin-right: auto;\n    line-height: 1.6;\n    color: #666666;\n  }\n  \n  .press-kit__content {\n    background: #ffffff;\n    padding: 50px 40px;\n    border-radius: 15px;\n    box-shadow: 0 10px 30px rgba(0,0,0,0.1);\n    margin: 40px auto;\n    max-width: 500px;\n    transition: transform 0.3s ease, box-shadow 0.3s ease;\n  }\n  \n  .press-kit__content:hover {\n    transform: translateY(-5px);\n    box-shadow: 0 20px 40px rgba(0,0,0,0.15);\n  }\n  \n  .press-kit__icon {\n    color: #1a1a1a;\n    margin-bottom: 30px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 80px;\n    height: 80px;\n    background: #f0f0f0;\n    border-radius: 50%;\n  }\n  \n  .press-kit__download-btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    background: #1a1a1a;\n    color: #ffffff;\n    padding: 16px 32px;\n    border-radius: 25px;\n    text-decoration: none;\n    font-family: 'Poppins', sans-serif;\n    font-weight: 600;\n    font-size: 16px;\n    transition: all 0.3s ease;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n  \n  .press-kit__download-btn:hover {\n    background: #333333;\n    color: #ffffff;\n    transform: translateY(-2px);\n    box-shadow: 0 10px 25px rgba(0,0,0,0.2);\n  }\n  \n  .press-kit__file-info {\n    margin-top: 20px;\n    font-size: 14px;\n    color: #999999;\n    font-style: italic;\n  }\n  \n  .press-kit__contact {\n    margin-top: 30px;\n    padding-top: 30px;\n    border-top: 1px solid rgba(0,0,0,0.1);\n    font-size: 14px;\n    color: #666666;\n  }\n  \n  /* Mobile responsive */\n  @media screen and (max-width: 768px) {\n    .press-kit-section {\n      padding: 50px 0;\n    }\n    \n    .press-kit-container {\n      padding: 0 15px;\n    }\n    \n    .press-kit__heading {\n      font-size: 36px;\n    }\n    \n    .press-kit__description {\n      font-size: 16px;\n    }\n    \n    .press-kit__content {\n      padding: 30px 20px;\n      margin: 20px auto;\n    }\n    \n    .press-kit__download-btn {\n      padding: 14px 24px;\n      font-size: 15px;\n    }\n    \n    .press-kit__icon {\n      width: 60px;\n      height: 60px;\n    }\n    \n    .press-kit__icon svg {\n      width: 36px;\n      height: 36px;\n    }\n  }\n</style>"
